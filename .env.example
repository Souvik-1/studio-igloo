# Studio Igloo Environment Variables Example

# Resend API Key for contact form email delivery
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Email recipient (Studio owner)
CONTACT_TO_EMAIL=hello@studioigloo.com

# Verified sender email address in Resend
CONTACT_FROM_EMAIL=Studio Igloo <onboarding@resend.dev>

# Cloudflare Turnstile Secret Key
TURNSTILE_SECRET_KEY=0x4AAAAAAAx_1234567890
